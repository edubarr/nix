# Example environment file for Immich on hydra.
#
# Copy to /srv/configs/immich/.env and replace the placeholder passwords.
# This file is read by immich-server, immich-machine-learning and
# immich-database. Keep DB_* and POSTGRES_* values in sync.

# Local timezone.
TZ=America/Sao_Paulo

# Credentials consumed by immich-server (DB_*).
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Credentials consumed by the PostgreSQL container (POSTGRES_*).
POSTGRES_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_DB=immich
